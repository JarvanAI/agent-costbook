# Local SQLite file. Use a temporary path in tests; do not point this at a database you cannot replace.
ACB_DB=agent_costbook.sqlite3

# Bearer token for contributions, publication, observation import, and M7 reads.
# Do not commit a real token.
ACB_ADMIN_TOKEN=

# Optional read token for capability reads and capability-enriched estimates.
# ACB_READ_TOKEN=

# Optional local config file path (Linux default: ~/.config/agent-costbook/config.json).
# ACB_CONFIG=

# Optional query target service URL (default: http://127.0.0.1:8080).
# HTTP is allowed only on loopback; HTTPS targets can be remote.
# Affects ac query commands when --server is omitted.
# Note: ac serve uses --host/--port and binds only loopback; ac estimate requires explicit --server.
# ACB_SERVER=http://127.0.0.1:8080
