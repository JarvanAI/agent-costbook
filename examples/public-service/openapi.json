            "maxLength": 80,
            "minLength": 1,
            "title": "Plan",
            "type": "string"
          },
          "provider": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          },
          "window_end": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Window End"
          },
