            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Start"
          }
        },
        "required": [
          "candidate_id",
          "provider",
          "channel",
          "model",
          "plan",
          "feature_scope"
        ],
        "title": "PublicCandidateIn",
        "type": "object"
      },
      "PublicErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "loc": {
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "type": "array"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "loc"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "PublicErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/PublicErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PublicEstimateIn": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/PublicCandidateIn"
            },
            "maxItems": 64,
            "minItems": 1,
            "title": "Candidates",
            "type": "array"
          },
          "currency": {
            "maxLength": 12,
            "minLength": 1,
            "title": "Currency",
            "type": "string"
          },
          "extra_cost": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extra Cost"
          },
          "method": {
            "enum": [
              "M0",
              "M1",
              "M2",
              "M3",
              "M4",
              "M5",
              "M6"
            ],
            "maxLength": 16,
            "minLength": 1,
            "title": "Method",
            "type": "string"
          },
          "reference_candidate_id": {
            "anyOf": [
              {
                "maxLength": 160,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Candidate Id"
          },
          "scenario": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScenarioIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "snapshot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Id"
          },
          "usage": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usage"
          }
        },
        "required": [
          "method",
          "currency",
          "candidates"
        ],
        "title": "PublicEstimateIn",
        "type": "object"
      },
      "ScenarioIn": {
        "additionalProperties": false,
        "properties": {
          "equal_baseline_budget": {
            "default": false,
            "title": "Equal Baseline Budget",
            "type": "boolean"
          },
          "equal_baseline_tasks": {
            "default": false,
            "title": "Equal Baseline Tasks",
            "type": "boolean"
          }
        },
        "title": "ScenarioIn",
        "type": "object"
      }
    }
  },
